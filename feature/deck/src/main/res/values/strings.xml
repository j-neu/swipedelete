<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Session history strip (SPEC 5.5). Each entry names the action and the
         item it applied to, so a chip can be individually reverted. -->
    <string name="history_entry_staged">staged %1$s</string>
    <string name="history_entry_kept">kept %1$s</string>
    <string name="history_entry_moved">moved %1$s to slot %2$d</string>
    <string name="history_entry_deferred">deferred %1$s</string>
    <string name="history_entry_undo">undo</string>

    <!-- Swipe surface (SPEC 5.2 / 11.4). The destructive direction shows colour
         AND icon AND this text: colour is never the sole signal. The same label
         names the equivalent non-gesture accessibility action. -->
    <string name="swipe_delete">Delete</string>
    <string name="swipe_keep">Keep</string>
    <string name="swipe_defer">Defer</string>
    <!-- Drag-down reveals the dock; "Move" is its non-gesture equivalent (AC-19). -->
    <string name="swipe_move">Move</string>
    <!-- Task 30 / §9.4: a capped walk is shown as partial, never as complete. -->
    <string name="deck_partial_banner">Partial deck — the scan stopped early after %1$d items seen</string>
    <!-- AC-8: an item that changed on disk is aborted with a visible reason. -->
    <string name="deck_stale_abort">%1$d item(s) changed on disk and were not deleted: %2$s</string>
    <!-- An item the storage layer did not move is never shown as deleted. -->
    <string name="deck_apply_failed">%1$d item(s) were not deleted and are still staged: %2$s</string>
    <string name="deck_reason_protected">in a protected folder</string>
    <string name="deck_reason_space">not enough free space to keep a recoverable copy</string>
    <string name="deck_reason_delete_refused">Android did not let this app remove the original</string>
    <string name="deck_error">That did not work: %1$s</string>
    <string name="deck_finish">Finish session</string>
    <string name="deck_move_unavailable">That slot destination is no longer available</string>
    <string name="deck_empty">No sources to review yet</string>
    <string name="deck_dismiss">Dismiss</string>
</resources>
